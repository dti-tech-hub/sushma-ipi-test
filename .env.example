# =============================================================================
# Copy to .env  ->  cp .env.example .env   (never commit the real .env)
# EVERYTHING HERE IS OPTIONAL. With an empty .env the project runs in
# DEMO MODE using the deterministic mock LLM provider. No API key required.
# =============================================================================

# --- Global switch -----------------------------------------------------------
# true  = force the deterministic mock provider (offline, reproducible)
# false = use the provider configured in configs/default.yaml
TESTRANGE_DEMO_MODE=true

# --- OpenAI-compatible provider (also works with Azure / vLLM / Groq /
#     OpenRouter / LM Studio by changing TESTRANGE_OPENAI__BASE_URL) --------
OPENAI_API_KEY=
TESTRANGE_OPENAI__BASE_URL=
TESTRANGE_OPENAI__MODEL=gpt-4o-mini

# --- Anthropic-compatible provider -------------------------------------------
ANTHROPIC_API_KEY=
TESTRANGE_ANTHROPIC__MODEL=claude-3-5-haiku-20241022

# --- Ollama / local models ---------------------------------------------------
# Requires a running `ollama serve` on the machine.
TESTRANGE_OLLAMA__BASE_URL=http://localhost:11434
TESTRANGE_OLLAMA__MODEL=llama3.1:8b

# --- Experiment overrides ----------------------------------------------------
TESTRANGE_MODEL__PROVIDER=mock
TESTRANGE_MODEL__NAME=mock-vulnerable
TESTRANGE_EXECUTION__REPETITIONS=3
TESTRANGE_EXECUTION__RANDOM_SEED=1337
TESTRANGE_PATHS__DB_PATH=data/testrange.db

# --- API server --------------------------------------------------------------
TESTRANGE_API__HOST=127.0.0.1
TESTRANGE_API__PORT=8000